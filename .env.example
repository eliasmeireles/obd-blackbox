# Copy to .env. Replace the example key, cookie secret and database password.
POSTGRES_DB=obd_blackbox
POSTGRES_USER=obd_blackbox
POSTGRES_PASSWORD=change-me-local-database-password
DATABASE_URL=postgres://obd_blackbox:change-me-local-database-password@postgres:5432/obd_blackbox?sslmode=disable
API_KEYS=phone:change-me-phone-key-at-least-32-characters
COOKIE_SECRET=change-me-cookie-secret-at-least-32-bytes
COOKIE_SECURE=false
HTTP_ADDR=:8080
APP_URL=http://localhost:8080
DISPLAY_TIMEZONE=UTC
SESSION_TTL=720h
LOG_LEVEL=info
LOG_RETENTION=720h
LOG_PRUNE_INTERVAL=1h
